[Unit]
Description=Unipivot Backend API Server
After=network.target

[Service]
Type=simple
User=jit
WorkingDirectory=/home/jit/unipivot/backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=unipivot-backend
Environment=NODE_ENV=production
Environment=PORT=3010

[Install]
WantedBy=multi-user.target
